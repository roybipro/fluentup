{
  "name": "fluentup-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FluentUp - Production English Learning & AI Tutor Monorepo (Android Expo + FastAPI + Supabase)",
  "scripts": {
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:test": "npm --prefix apps/mobile run test",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "backend:test": "cd apps/backend && .venv/bin/pytest -v",
    "backend:dev": "cd apps/backend && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "test": "npm run mobile:test && npm run backend:test",
    "typecheck": "npm run mobile:typecheck"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
