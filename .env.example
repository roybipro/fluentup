# ==============================================================================
# FLUENTUP ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` in root, `apps/mobile/.env`, and `apps/backend/.env`.
# NEVER commit real secrets, service-role keys, or signing passwords to Git.
# ==============================================================================

# --- Environment Mode ---
APP_ENV=development
# Allowed values: development | staging | production

# --- Android Application Configuration (apps/mobile) ---
APP_PACKAGE_ID=com.fluentup.app
APP_VERSION_NAME=1.0.0
APP_VERSION_CODE=1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://YOUR_DOMAIN_PLACEHOLDER.example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://YOUR_DOMAIN_PLACEHOLDER.example.com/terms
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://YOUR_DOMAIN_PLACEHOLDER.example.com/delete-account
EXPO_PUBLIC_SUPPORT_EMAIL=support@YOUR_DOMAIN_PLACEHOLDER.example.com

# --- FastAPI Backend Configuration (apps/backend) ---
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=FluentUp API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fluentup
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key-placeholder
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY strictly on the backend server.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# --- LLM / AI Provider Configuration (Server-Side Only!) ---
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-optional-openai-api-key-placeholder
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_DAILY_REQUESTS_FREE=30
AI_MAX_DAILY_REQUESTS_PREMIUM=300

# --- Security & Operational Safeguards ---
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN_PLACEHOLDER.example.com,http://localhost:8081
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=262144
LOG_LEVEL=INFO

# --- Android Release Signing (Used only during local/CI release build; never committed) ---
ANDROID_KEYSTORE_PATH=/secure/path/to/fluentup-upload-key.jks
ANDROID_KEYSTORE_PASSWORD=your-keystore-password-placeholder
ANDROID_KEY_ALIAS=fluentup-upload
ANDROID_KEY_PASSWORD=your-key-password-placeholder
